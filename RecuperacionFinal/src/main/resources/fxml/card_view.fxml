<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?> <VBox fx:id="cardRoot" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #cccccc; -fx-border-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);" prefWidth="240.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dam.DI.RecuperacionFinal.controller.CardController">
    <children>
        <ImageView fx:id="imgCar" fitHeight="115.0" fitWidth="210.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-radius: 4;" />

        <Label fx:id="lblBrandModel" text="Brand Model" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
        <Label fx:id="lblSpecs" text="Specs" style="-fx-text-fill: #666666;" />

        <Label fx:id="lblRegistrationDate" text="Registered: 2026-05-21" style="-fx-text-fill: #888888; -fx-font-size: 11px;" />

        <Separator />

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <ToggleButton fx:id="btnFavorite" text="🖤 Add Favorite" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <HBox fx:id="adminActionsContainer" spacing="8.0" alignment="CENTER">
            <children>
                <Button fx:id="btnUpdate" text="UPDATE" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" />
                <Button fx:id="btnDelete" text="DELETE" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" />
            </children>
        </HBox>
    </children>
</VBox>