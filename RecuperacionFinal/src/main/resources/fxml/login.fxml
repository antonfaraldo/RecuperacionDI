<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-padding: 40;" prefWidth="400.0" prefHeight="500.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dam.DI.RecuperacionFinal.controller.LoginController">
   <children>
      <Label text="INICIAR SESIÓN">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox spacing="5.0" fillWidth="true">
         <children>
            <Label text="Usuario:" />
            <TextField fx:id="txtUsername" promptText="Introduce tu usuario" />
         </children>
      </VBox>
      <VBox spacing="5.0" fillWidth="true">
         <children>
            <Label text="Contraseña:" />
            <PasswordField fx:id="txtPassword" promptText="Introduce tu contraseña" />
         </children>
      </VBox>
      <Label fx:id="lblError" textFill="RED" wrapText="true" />
      <Button mnemonicParsing="false" onAction="#handleLogin" prefWidth="150.0" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-cursor: hand;" text="Entrar" />
      <Hyperlink onAction="#navigateToRegister" text="¿No tienes cuenta? Regístrate aquí" />
   </children>
</VBox>