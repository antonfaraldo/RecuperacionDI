<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-padding: 40;" prefWidth="400.0" prefHeight="550.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dam.DI.RecuperacionFinal.controller.RegisterController">
   <children>
      <Label text="REGISTRO DE USUARIO">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox spacing="5.0">
         <children>
            <Label text="Nombre de Usuario:" />
            <TextField fx:id="txtUsername" promptText="Mínimo un usuario único" />
         </children>
      </VBox>
      <VBox spacing="5.0">
         <children>
            <Label text="Correo Electrónico:" />
            <TextField fx:id="txtEmail" promptText="ejemplo@mail.com" />
         </children>
      </VBox>
      <VBox spacing="5.0">
         <children>
            <Label text="Contraseña:" />
            <PasswordField fx:id="txtPassword" promptText="Mínimo 6 caracteres (letras y números)" />
         </children>
      </VBox>
      <VBox spacing="5.0">
         <children>
            <Label text="Confirmar Contraseña:" />
            <PasswordField fx:id="txtConfirmPassword" promptText="Repite la contraseña" />
         </children>
      </VBox>
      <Label fx:id="lblStatus" textFill="RED" wrapText="true" />
      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleRegister" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-cursor: hand;" text="Registrar" />
            <Button mnemonicParsing="false" onAction="#navigateToLogin" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-cursor: hand;" text="Cancelar" />
         </children>
      </HBox>
   </children>
</VBox>