<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.dam.DI.RecuperacionFinal.controller.UsersController">
    <children>
        <Label text="Panel de Administración de Usuarios">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>

        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="usersTable" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUsername" prefWidth="110.0" text="Usuario"/>
                        <TableColumn fx:id="colEmail" prefWidth="160.0" text="Email"/>
                        <TableColumn fx:id="colPassword" prefWidth="180.0" text="Contraseña (Hash)"/>
                        <TableColumn fx:id="colRole" prefWidth="90.0" text="Rol"/>
                        <TableColumn fx:id="colFavoriteCarId" prefWidth="110.0" text="Coche Fav. (ID)"/>
                    </columns>
                </TableView>

                <VBox spacing="12.0" prefWidth="200.0"
                      style="-fx-background-color: #f4f4f4; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #e0e0e0; -fx-border-radius: 6;">
                    <children>
                        <Label text="Buscador Real:" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>
                        <TextField fx:id="txtSearch" promptText="Filtrar registros..."/>

                        <Separator style="-fx-padding: 5 0 5 0;"/>

                        <Label text="Operaciones CRUD:" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>
                        <Button fx:id="btnCreate" text="Crear Usuario" maxWidth="Infinity"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Button fx:id="btnModify" text="Modificar" maxWidth="Infinity"/>
                        <Button fx:id="btnDelete" text="Eliminar" maxWidth="Infinity"
                                style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
                        <Button fx:id="btnChangeRole" text="Cambiar Rol" maxWidth="Infinity"
                                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>